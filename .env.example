# Copia este archivo como .env y completa la contraseña.
# Docker Compose lo usa al leer compose.yaml.
# No subas .env al repositorio.

POSTGRES_DB=practicasiat
POSTGRES_USER=usuario_siat
POSTGRES_PASSWORD=

# Spring Boot lee estas variables si arrancas el backend
# sin backend/config/application.properties.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/practicasiat
SPRING_DATASOURCE_USERNAME=usuario_siat
SPRING_DATASOURCE_PASSWORD=
